{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".output/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-code-policy#lint": {
      "dependsOn": ["build", "^build"]
    },
    "lint:fix": {},
    "lint:suppress": {
      "cache": false
    },
    "lint:prune": {
      "cache": false
    },
    "format": {},
    "format:check": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "perf:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dupes": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
