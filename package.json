{
  "name": "engineering-baseline",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "sync-versions": "node scripts/sync-versions.mjs",
    "sync-versions:check": "node scripts/sync-versions.mjs --check",
    "check:all": "turbo run type-check lint:fix && pnpm format",
    "fix:all": "pnpm sync-versions && turbo run fix && pnpm format",
    "check:ci": "pnpm sync-versions:check && turbo run type-check lint test build && pnpm format:check",
    "perf:check": "turbo run perf:check"
  },
  "devDependencies": {
    "@busirocket/prettier-config": "workspace:*",
    "@types/node": "^25.9.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.16",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
