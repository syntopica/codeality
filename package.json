{
  "name": "engineering-baseline",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:suppress": "turbo run lint:suppress",
    "lint:prune": "turbo run lint:prune",
    "type-check": "turbo run type-check",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-check.mjs",
    "type-coverage": "baseline-type-coverage packages templates",
    "sync-versions": "node scripts/sync-versions.mjs",
    "sync-versions:check": "node scripts/sync-versions.mjs --check",
    "dupes": "baseline-dupes packages scripts",
    "knip": "knip",
    "knip:templates": "pnpm -r --filter \"./templates/*\" knip",
    "deps:graph": "depcruise packages templates scripts",
    "deps:graph:aliased": "node scripts/deps-graph-aliased.mjs",
    "check:all": "turbo run type-check lint:fix && pnpm format && pnpm dupes",
    "fix:all": "pnpm sync-versions && turbo run fix && pnpm format",
    "check:ci": "pnpm sync-versions:check && pnpm lint:fast && turbo run type-check lint test build && pnpm lint:root && pnpm format:check && pnpm dupes",
    "perf:check": "turbo run perf:check",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level moderate",
    "workflows:check": "actionlint",
    "publish:check": "turbo run publish:check",
    "check:quality": "node scripts/check-quality.mjs",
    "check:security": "pnpm secrets:check && pnpm audit:check && pnpm workflows:check",
    "conformance": "node packages/create-baseline/bin/create-baseline.mjs --check",
    "estate": "node packages/create-baseline/bin/baseline-estate.mjs",
    "lint:root": "eslint scripts eslint.config.ts knip.config.ts \"*.json\" \"*.md\" \".github/**/*.yml\" --max-warnings 0",
    "lint:fast": "oxlint --deny-warnings packages scripts templates"
  },
  "devDependencies": {
    "@syntopica/eslint-config": "workspace:*",
    "@syntopica/prettier-config": "workspace:*",
    "@syntopica/quality-config": "workspace:*",
    "@syntopica/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/markdown": "^8.0.3",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "lefthook": "^2.1.17",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.1.0",
    "turbo": "^2.11.7",
    "type-coverage": "^2.30.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
