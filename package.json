{
  "name": "engineering-baseline",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:suppress": "turbo run lint:suppress",
    "lint:prune": "turbo run lint:prune",
    "type-check": "turbo run type-check",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "sync-versions": "node scripts/sync-versions.mjs",
    "sync-versions:check": "node scripts/sync-versions.mjs --check",
    "dupes": "jscpd packages scripts",
    "knip": "knip",
    "deps:graph": "depcruise packages templates scripts",
    "check:all": "turbo run type-check lint:fix && pnpm format && pnpm dupes",
    "fix:all": "pnpm sync-versions && turbo run fix && pnpm format",
    "check:ci": "pnpm sync-versions:check && turbo run type-check lint test build && pnpm format:check && pnpm dupes",
    "perf:check": "turbo run perf:check"
  },
  "devDependencies": {
    "@busirocket/prettier-config": "workspace:*",
    "@busirocket/quality-config": "workspace:*",
    "@types/node": "^26.1.2",
    "dependency-cruiser": "^18.1.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
