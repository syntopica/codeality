{
  "name": "@syntopica/quality-config",
  "version": "0.13.1",
  "private": false,
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "description": "Shared configuration for cross-file quality gates: knip, dependency-cruiser, type-coverage, jscpd, lefthook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntopica/codeality.git",
    "directory": "packages/quality-config"
  },
  "homepage": "https://github.com/syntopica/codeality/tree/main/packages/quality-config#readme",
  "bugs": {
    "url": "https://github.com/syntopica/codeality/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "baseline-audit": "bin/baseline-audit.mjs",
    "baseline-deps-graph": "bin/baseline-deps-graph.mjs",
    "baseline-dupes": "bin/baseline-dupes.mjs",
    "baseline-env-init": "bin/baseline-env-init.mjs",
    "baseline-hooks-install": "bin/baseline-hooks-install.mjs",
    "baseline-licenses": "bin/baseline-licenses.mjs",
    "baseline-type-coverage": "bin/baseline-type-coverage.mjs"
  },
  "files": [
    "LICENSE",
    "PUBLIC_API.md",
    "README.md",
    "bin",
    "jscpd.json",
    "oxlintrc.json",
    "src",
    "tsconfig.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./knip": "./src/knip.ts",
    "./dependency-cruiser": "./src/dependency-cruiser.ts",
    "./type-coverage": "./src/type-coverage.ts",
    "./lefthook": "./src/lefthook.ts",
    "./jscpd": "./jscpd.json",
    "./commitlint": "./src/commitlint.ts",
    "./oxlint": "./oxlintrc.json",
    "./pnpm-command": "./bin/pnpmCommand.mjs"
  },
  "scripts": {
    "fix": "pnpm run lint:fix",
    "lint": "eslint src bin tests --max-warnings 0",
    "lint:fix": "eslint src bin tests --fix",
    "lint:suppress": "eslint src bin tests --suppress-all",
    "lint:prune": "eslint src bin tests --prune-suppressions",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "publish:check": "baseline-licenses && publint --strict && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm internal-resolution-error"
  },
  "peerDependencies": {
    "@commitlint/config-conventional": ">=21.0.0",
    "dependency-cruiser": ">=18.0.0",
    "knip": ">=6.0.0",
    "oxlint": ">=1.0.0",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "dependency-cruiser": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "@commitlint/config-conventional": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@syntopica/eslint-config": "workspace:*",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.40.0",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
