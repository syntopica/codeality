{
  "minTokens": 70,
  "threshold": 1,
  "format": ["typescript", "tsx", "javascript", "jsx", "vue", "astro", "rust"],
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.output/**",
    "**/target/**",
    "**/coverage/**"
  ],
  "reporters": ["console"]
}
