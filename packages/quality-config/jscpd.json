{
  "minTokens": 70,
  "threshold": 1,
  "format": [
    "typescript",
    "tsx",
    "javascript",
    "jsx",
    "vue",
    "astro",
    "rust",
    "dart",
    "swift"
  ],
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.output/**",
    "**/target/**",
    "**/coverage/**",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/.build/**",
    "**/build/**",
    "**/.dart_tool/**"
  ],
  "reporters": ["console"]
}
