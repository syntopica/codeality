{
  "name": "@syntopica/ui-quality",
  "version": "0.7.0",
  "private": false,
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "description": "Design gate for rendered web UIs: drive the real routes in Playwright, light and dark, at several widths, and report contrast, clipping, misaligned columns, cramped controls, wasted width and off-palette colours",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntopica/codeality.git",
    "directory": "packages/ui-quality"
  },
  "homepage": "https://github.com/syntopica/codeality/tree/main/packages/ui-quality#readme",
  "bugs": {
    "url": "https://github.com/syntopica/codeality/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codeality-ui": "bin/codeality-ui.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests bin --max-warnings 0",
    "lint:fix": "eslint src tests bin --fix",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "publish:check": "baseline-licenses && publint --strict"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "devDependencies": {
    "@syntopica/gate-kit": "workspace:*",
    "@syntopica/quality-config": "workspace:*",
    "@syntopica/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
