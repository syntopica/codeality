{
  "extends": "@syntopica/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "tsup.config.ts",
    "vitest.config.ts",
    "tsup.probe.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
