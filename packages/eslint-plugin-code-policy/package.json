{
  "name": "eslint-plugin-code-policy",
  "version": "0.7.4",
  "description": "Architectural linting for TypeScript · enforce atomic files, explicit public APIs, clean runtime boundaries, and view/logic separation.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./configs/recommended": {
      "import": {
        "types": "./dist/configs/recommended.d.ts",
        "default": "./dist/configs/recommended.js"
      },
      "require": {
        "types": "./dist/configs/recommended.d.cts",
        "default": "./dist/configs/recommended.cjs"
      }
    },
    "./configs/strict": {
      "import": {
        "types": "./dist/configs/strict.d.ts",
        "default": "./dist/configs/strict.js"
      },
      "require": {
        "types": "./dist/configs/strict.d.cts",
        "default": "./dist/configs/strict.cjs"
      }
    },
    "./configs/react": {
      "import": {
        "types": "./dist/configs/react.d.ts",
        "default": "./dist/configs/react.js"
      },
      "require": {
        "types": "./dist/configs/react.d.cts",
        "default": "./dist/configs/react.cjs"
      }
    },
    "./configs/next": {
      "import": {
        "types": "./dist/configs/next.d.ts",
        "default": "./dist/configs/next.js"
      },
      "require": {
        "types": "./dist/configs/next.d.cts",
        "default": "./dist/configs/next.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/emit-cjs-types.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "lint:suppress": "eslint src tests --suppress-all",
    "lint:prune": "eslint src tests --prune-suppressions",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "publish:check": "baseline-licenses && publint --strict && attw --pack . --profile node16",
    "mutation": "stryker run"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "typescript",
    "architectural-linting",
    "atomic-file",
    "public-api",
    "module-boundaries",
    "react",
    "nextjs",
    "monorepo",
    "code-policy",
    "flat-config"
  ],
  "author": {
    "name": "Cristian Deluxe",
    "url": "https://github.com/cristiandeluxe"
  },
  "license": "MIT",
  "homepage": "https://github.com/BusiRocket/baseline/tree/main/packages/eslint-plugin-code-policy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusiRocket/baseline.git",
    "directory": "packages/eslint-plugin-code-policy"
  },
  "bugs": {
    "url": "https://github.com/BusiRocket/baseline/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.68.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@busirocket/tsconfig": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-regexp": "^3.2.0",
    "publint": "^0.3.24",
    "tsc-alias": "^1.9.2",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
