{
  "name": "@busirocket/create-baseline",
  "version": "0.3.4",
  "private": false,
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "description": "CLI to verify and adopt @busirocket baseline config packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusiRocket/baseline.git",
    "directory": "packages/create-baseline"
  },
  "homepage": "https://github.com/BusiRocket/baseline/tree/main/packages/create-baseline#readme",
  "bugs": {
    "url": "https://github.com/BusiRocket/baseline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-baseline": "bin/create-baseline.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "baseline-versions.json",
    "bin"
  ],
  "scripts": {
    "check:self": "node ./bin/create-baseline.mjs --check",
    "publish:check": "publint --strict && attw --pack . --profile node16"
  },
  "keywords": [
    "eslint",
    "prettier",
    "typescript",
    "baseline"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.22"
  }
}
