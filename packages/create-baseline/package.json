{
  "name": "@syntopica/create-baseline",
  "version": "0.9.0",
  "private": false,
  "packageManager": "pnpm@12.5.1",
  "license": "MIT",
  "description": "CLI to verify and adopt @syntopica baseline config packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntopica/codeality.git",
    "directory": "packages/create-baseline"
  },
  "homepage": "https://github.com/syntopica/codeality/tree/main/packages/create-baseline#readme",
  "bugs": {
    "url": "https://github.com/syntopica/codeality/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-baseline": "bin/create-baseline.mjs",
    "baseline-estate": "bin/baseline-estate.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "baseline-versions.json",
    "python-versions.json",
    "bin"
  ],
  "scripts": {
    "check:self": "node ./bin/create-baseline.mjs --check",
    "lint": "eslint bin tests --max-warnings 0",
    "lint:fix": "eslint bin tests --fix",
    "lint:suppress": "eslint bin tests --suppress-all",
    "lint:prune": "eslint bin tests --prune-suppressions",
    "test": "vitest run --coverage",
    "publish:check": "baseline-licenses && publint --strict && attw --pack . --profile node16"
  },
  "keywords": [
    "eslint",
    "prettier",
    "typescript",
    "baseline"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@syntopica/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-regexp": "^3.3.1",
    "publint": "^0.3.24",
    "vitest": "^5.0.1"
  }
}
