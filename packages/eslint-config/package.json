    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": ">=15.0.0",
    "@vitest/eslint-plugin": ">=1.0.0",
    "eslint": ">=9.0.0",
