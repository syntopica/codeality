{
  "name": "@busirocket/eslint-config",
  "version": "0.5.0",
  "private": false,
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "description": "Shared ESLint configuration baseline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusiRocket/baseline.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/BusiRocket/baseline/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/BusiRocket/baseline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "eslint.config.ts",
    "tsconfig.json",
    "PUBLIC_API.md"
  ],
  "exports": {
    "./base": "./src/base.ts",
    "./nextjs": "./src/nextjs.ts",
    "./astro": "./src/astro.ts",
    "./vite-react": "./src/vite-react.ts",
    "./vite-vue": "./src/vite-vue.ts",
    "./node": "./src/node.ts",
    "./nestjs": "./src/nestjs.ts",
    "./code-quality": "./src/code-quality.ts",
    "./accessibility": "./src/accessibility.ts",
    "./tailwind": "./src/tailwind.ts",
    "./frontend-boundaries": "./src/frontend-boundaries.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "fix": "pnpm run lint:fix",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:suppress": "eslint src --suppress-all",
    "lint:prune": "eslint src --prune-suppressions",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "publish:check": "publint --strict && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm internal-resolution-error"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
