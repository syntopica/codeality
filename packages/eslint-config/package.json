    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-testing-library": ">=7.0.0",
    "eslint-plugin-unicorn": ">=57.0.0",
    "eslint-plugin-vue": ">=10.0.0",
    "eslint-plugin-vuejs-accessibility": ">=2.4.0",
    "globals": ">=15.0.0",
    "typescript": ">=5.4.0",
    "vue-eslint-parser": ">=10.0.0"
  },
