{
  "name": "@syntopica/test-quality",
  "version": "0.1.1",
  "private": false,
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "description": "Test-suite cost audit: find where a vitest suite spends its time and memory (DOM environments for DOM-free tests, files run twice, uncached local gates, hooks that repeat a gate)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntopica/codeality.git",
    "directory": "packages/test-quality"
  },
  "homepage": "https://github.com/syntopica/codeality/tree/main/packages/test-quality#readme",
  "bugs": {
    "url": "https://github.com/syntopica/codeality/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codeality-test": "bin/codeality-test.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests bin --max-warnings 0",
    "lint:fix": "eslint src tests bin --fix",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "publish:check": "baseline-licenses && publint --strict"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@syntopica/gate-kit": "workspace:*",
    "@syntopica/quality-config": "workspace:*",
    "@syntopica/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
