{
  "name": "my-vite-react-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "lefthook install && baseline-env-init",
    "dev": "vite",
    "build": "node node_modules/@typescript/native/bin/tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:suppress": "eslint src --suppress-all",
    "lint:prune": "eslint src --prune-suppressions",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dupes": "baseline-dupes .",
    "knip": "knip",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check:ci": "pnpm lint:fast && pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes && pnpm knip",
    "test:a11y": "vitest run",
    "perf:check": "baseline-env-init && pnpm build && lhci autorun --config=.lighthouserc.json && pnpm size",
    "deps:graph": "depcruise src",
    "type-coverage": "baseline-type-coverage",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level moderate",
    "check:quality": "pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "lint:fast": "oxlint --deny-warnings .",
    "size": "size-limit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@busirocket/eslint-config": "workspace:*",
    "@busirocket/prettier-config": "workspace:*",
    "@busirocket/quality-config": "workspace:*",
    "@busirocket/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-code-policy": "workspace:*",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.14",
    "jsdom": "^30.0.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
