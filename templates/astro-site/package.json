{
  "name": "my-astro-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "prepare": "lefthook install && baseline-env-init",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:suppress": "eslint src --suppress-all",
    "lint:prune": "eslint src --prune-suppressions",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "astro check && node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dupes": "baseline-dupes .",
    "knip": "knip",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check:ci": "pnpm lint:fast && pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes && pnpm knip",
    "perf:check": "baseline-env-init && pnpm build && lhci autorun --config=.lighthouserc.json && pnpm size",
    "deps:graph": "depcruise src",
    "type-coverage": "baseline-type-coverage",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level moderate",
    "check:quality": "pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "lint:fast": "oxlint --deny-warnings .",
    "size": "size-limit"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@syntopica/eslint-config": "workspace:*",
    "@syntopica/prettier-config": "workspace:*",
    "@syntopica/quality-config": "workspace:*",
    "@syntopica/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-code-policy": "workspace:*",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.0.0",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
